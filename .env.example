# gork settings. Copy to .env and fill in the required ones; the rest are defaults you can tune later.
# Comments must be on their own lines, and values are not quoted.

# ===== Discord =====
# Required. Bot token: Developer Portal > your app > Bot > Reset Token (paste it yourself).
DISCORD_TOKEN=
# Required. Server IDs gork may answer in, comma-separated.
GUILD_IDS=
# Limit gork to these channel IDs (threads follow their parent). Empty: any channel it can see in those servers.
ALLOWED_CHANNEL_IDS=
# Personality: a preset from personas/ (default, witty, hype, noir, professor) or custom for your own personas/custom.md. Applied on the next npm run up.
PERSONA=default
# Who gork may ping: none, all, or some of reply (the asker), users, roles, everyone. users = people in the conversation (at most 5 per reply). @everyone only when the asker may and asks for it; locked roles only if the asker could ping them.
MENTIONS=none
# Time zone for the events gork creates (an IANA name such as America/New_York). People say "Friday 8pm"; this is the clock that means.
TIMEZONE=UTC

# ===== Cloudflare =====
# Required. Your Cloudflare account ID (32 hex characters).
CF_ACCOUNT_ID=
# AI Gateway that npm run up creates, and overwrites with gork's settings. Use a name nothing else uses.
AI_GATEWAY_ID=gork
# Required. Runtime token (goes into the container): AI Gateway Read+Run, Workers AI Read, Websearch Run, Browser Run Write. Free mode needs only Workers AI Read and Browser Run Write.
CF_RUN_TOKEN=
# Required. Admin token (host only, never in the container; used by npm run up, gateway and destroy): AI Gateway Read + Write.
CF_ADMIN_TOKEN=

# ===== Model =====
# credits: prepaid AI Gateway credits (default). free: Workers AI's free daily allowance only (about 10,000 neurons a day, roughly 25-100 replies), no web search, and its model is text-only so it can't see images (a video gives only its transcript; generating images still works), and when it runs out the safety check fails closed so gork stops answering until 00:00 UTC. Only free on the Workers Free plan: on Workers Paid, use past the daily allowance is billed.
BILLING_MODE=credits
# OpenAI-compatible base URL (https only). Empty: Cloudflare Workers AI, through your AI Gateway (direct, no gateway, when BILLING_MODE=free).
LLM_BASE_URL=
# Model ID. Empty: @cf/zai-org/glm-5.3-flash, or @cf/zai-org/glm-4.7-flash when BILLING_MODE=free. Set the two prices below to match it.
LLM_MODEL=
# Key for LLM_BASE_URL. Empty: CF_RUN_TOKEN, which is only ever sent to Cloudflare endpoints.
LLM_API_KEY=
# low, medium, high or max; off leaves the field out of the request (GLM-5.3 cannot turn reasoning off).
LLM_REASONING_EFFORT=low
# USD per million input tokens for LLM_MODEL; drives the spend estimate.
LLM_PRICE_IN_PER_M=0.15
# USD per million output tokens for LLM_MODEL.
LLM_PRICE_OUT_PER_M=0.50

# ===== Tools =====
# Tool calls per reply, counting every tool (search, page read, transcript, image, poll, event, video frames). 0 turns tools off.
MAX_TOOL_CALLS=6
# Web Search provider on Cloudflare for a reply's first search: ceramic ($0.00025 a search), linkup ($0.005) or exa ($0.007; the only one that keeps a copy of your queries).
SEARCH_PROVIDER=ceramic
# Provider for a reply's further searches, and for a first search that fails or finds nothing: linkup, or none. Ignored when it is SEARCH_PROVIDER.
SEARCH_FALLBACK=linkup
# Fallback searches per UTC day, at most 2 in one reply ($0.005 each with linkup, so 20 is at most $0.10 a day). 0 turns the fallback off.
SEARCH_FALLBACK_PER_DAY=20
# Most characters of a web page the model reads.
FETCH_MAX_CHARS=20000
# Most characters of a YouTube transcript the model reads.
TRANSCRIPT_MAX_CHARS=30000
# Images gork may generate per UTC day (FLUX.1 schnell, Workers AI's free daily allowance; free on the Workers Free plan, billed past the allowance on Workers Paid). 0 turns images off.
IMAGES_PER_DAY=50
# Videos gork may watch per UTC day (speech transcription uses the free daily allowance on Workers Free and is billed by the minute on Workers Paid). 0 turns video off (the same way IMAGES_PER_DAY=0 turns images off).
VIDEOS_PER_DAY=20

# ===== Safety =====
# Safety-screen categories to block: some of S1,S3,S4,S9,S11, or none. S4 (sexual content involving minors) is always on, whatever you set.
GUARD_BLOCK=S1,S3,S4,S9,S11
# Block when the screen's probability of a violation is at least this (0 to 1).
GUARD_THRESHOLD=0.5
# Blocked requests in 24 hours before gork ignores that person. 0 never mutes.
STRIKE_LIMIT=3

# ===== Limits =====
# Spend cap per UTC day, as gork estimates it. npm run up sets the AI Gateway spend limit to about 1.2x this as a backstop.
DAILY_BUDGET_USD=0.50
# Seconds a person waits between requests.
COOLDOWN_SECONDS=3
# Recent messages gork reads, 1 to 100 (Discord's limit), each cut to 300 characters.
CONTEXT_MESSAGES=50

# ===== Host =====
# Which program runs gork's container: docker or podman. Empty: Docker if it is running, otherwise Podman.
CONTAINER_ENGINE=
# Empty: npm run up downloads the released image from GitHub (and builds it here if that fails). build: always build it here. Or the name of an image to run instead.
GORK_IMAGE=
